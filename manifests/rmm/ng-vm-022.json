{
  "$schema": "../../schemas/vm-manifest.schema.json",
  "apiVersion": "northgate/v1alpha1",
  "kind": "VirtualMachine",
  "metadata": {
    "assetId": "NG-VM-022",
    "name": "NG-RMM-CP01",
    "ownerRef": "northgate-owner",
    "purpose": "Private lab RMM monitoring server",
    "environment": "lab",
    "criticality": "high",
    "dataClassification": "confidential",
    "lifecycle": "approved",
    "reviewOrRetirementDate": "2026-10-04",
    "changeRef": "NG-CHG-20260904-001",
    "dependencies": []
