{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Beowxlf/northgate-vm-factory/schemas/storage-catalog.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["$schema", "apiVersion", "kind", "catalogVersion", "profiles"],
  "properties": {
    "$schema": { "const": "../schemas/storage-catalog.schema.json" },
    "apiVersion": { "const": "northgate/v1alpha1" },
    "kind": { "const": "StorageCatalog" },
    "catalogVersion": { "type": "string", "pattern": "^[0-9]{4}\\.[0-9]{2}\\.[0-9]{2}\\.[0-9]+$" },
    "profiles": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "serverPolicyId", "approvalStatus", "allowProvision", "criticalWorkloadsAllowed"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9.-]{1,63}$" },
          "serverPolicyId": { "type": "string", "pattern": "^[a-z0-9][a-z0-9.-]{1,63}$" },
          "approvalStatus": { "enum": ["proposed", "approved", "retired"] },
          "allowProvision": { "type": "boolean" },
          "criticalWorkloadsAllowed": { "type": "boolean" },
          "allowDataDisks": { "type": "boolean" },
          "maximumDataDiskCount": { "type": "integer", "minimum": 1, "maximum": 4 },
          "maximumDataDiskGiB": { "type": "integer", "minimum": 10, "maximum": 2048 },
          "maximumTotalDataDiskGiB": { "type": "integer", "minimum": 10, "maximum": 8192 }
        },
        "dependentRequired": {
          "allowDataDisks": ["maximumDataDiskCount", "maximumDataDiskGiB", "maximumTotalDataDiskGiB"],
          "maximumDataDiskCount": ["allowDataDisks", "maximumDataDiskGiB", "maximumTotalDataDiskGiB"],
          "maximumDataDiskGiB": ["allowDataDisks", "maximumDataDiskCount", "maximumTotalDataDiskGiB"],
          "maximumTotalDataDiskGiB": ["allowDataDisks", "maximumDataDiskCount", "maximumDataDiskGiB"]
        }
      }
    }
  }
}
