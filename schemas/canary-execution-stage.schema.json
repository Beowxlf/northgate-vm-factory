{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Beowxlf/northgate-vm-factory/schemas/canary-execution-stage.schema.json",
  "title": "NorthGate disposable canary execution-stage proposal",
  "type": "object",
  "additionalProperties": false,
  "required": ["$schema", "apiVersion", "kind", "stageVersion", "status", "effectiveState", "proposedStage"],
  "properties": {
    "$schema": { "const": "../schemas/canary-execution-stage.schema.json" },
    "apiVersion": { "const": "northgate/v1alpha1" },
    "kind": { "const": "CanaryExecutionStageProposal" },
    "stageVersion": { "type": "string", "pattern": "^[0-9]{4}\\.[0-9]{2}\\.[0-9]{2}\\.[0-9]+$" },
    "status": { "const": "proposed" },
    "effectiveState": {
      "type": "object",
      "additionalProperties": false,
      "required": ["applyEnabled", "executableActions"],
      "properties": {
        "applyEnabled": { "const": false },
        "executableActions": { "type": "array", "maxItems": 0 }
      }
    },
    "proposedStage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "activationMode",
        "authorizationClass",
        "requestKind",
        "plannerAction",
        "maximumConcurrent",
        "normalVirtualMachineManifestsAllowed",
        "requestMaySharePromotion",
        "requiredGates"
      ],
      "properties": {
        "activationMode": { "const": "separate-reviewed-change" },
        "authorizationClass": { "const": "disposable-canary-only" },
        "requestKind": { "const": "DisposableCanaryRequest" },
        "plannerAction": { "const": "Create" },
        "maximumConcurrent": { "const": 1 },
        "normalVirtualMachineManifestsAllowed": { "const": false },
        "requestMaySharePromotion": { "const": false },
        "requiredGates": {
          "type": "array",
          "const": [
            "control-plane-negative-tests-passed",
            "installed-canary-policy-promoted",
            "immutable-canary-image-promoted",
            "opaque-profiles-approved",
            "identity-ledger-reservation",
            "host-issued-plan-registered",
            "exact-plan-human-approval",
            "quarantine-route-proven",
            "signed-receipt-ready"
          ]
        }
      }
    }
  }
}
