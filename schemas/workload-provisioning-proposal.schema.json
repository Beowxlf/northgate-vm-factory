{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Beowxlf/northgate-vm-factory/schemas/workload-provisioning-proposal.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema",
    "apiVersion",
    "kind",
    "proposalVersion",
    "status",
    "execution",
    "governance",
    "catalogPromotion",
    "promotionSequence",
    "workloads"
  ],
  "properties": {
    "$schema": { "const": "../schemas/workload-provisioning-proposal.schema.json" },
    "apiVersion": { "const": "northgate/v1alpha1" },
    "kind": { "const": "WorkloadProvisioningProposal" },
    "proposalVersion": { "$ref": "#/$defs/version" },
    "status": { "const": "proposed" },
    "execution": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "deployable",
        "hostPlanRequired",
        "standardManifestsIncluded",
        "resourcePolicyMustRemainDisabled",
        "promotionMode"
      ],
      "properties": {
        "deployable": { "const": false },
        "hostPlanRequired": { "const": true },
        "standardManifestsIncluded": { "const": false },
        "resourcePolicyMustRemainDisabled": { "const": true },
        "promotionMode": { "const": "separate-reviewed-stages" }
      }
    },
    "governance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["assetIdentityState", "changeReferenceState", "catalogState", "applicationReleaseState"],
      "properties": {
        "assetIdentityState": { "const": "candidate-unreserved" },
        "changeReferenceState": { "const": "required-before-manifest" },
        "catalogState": { "const": "proposed" },
        "applicationReleaseState": { "const": "external-promotion-required" }
      }
    },
    "catalogPromotion": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "imageRef",
        "firmwareProfileRef",
        "storageProfileRef",
        "recoveryProfileRef",
        "accessProfileRef",
        "networkProfileRefs",
        "bootstrapProfileRefs"
      ],
      "properties": {
        "imageRef": { "$ref": "#/$defs/profileRef" },
        "firmwareProfileRef": { "$ref": "#/$defs/profileRef" },
        "storageProfileRef": { "$ref": "#/$defs/profileRef" },
        "recoveryProfileRef": { "$ref": "#/$defs/profileRef" },
        "accessProfileRef": { "$ref": "#/$defs/profileRef" },
        "networkProfileRefs": {
          "type": "array",
          "minItems": 1,
          "maxItems": 8,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/profileRef" }
        },
        "bootstrapProfileRefs": {
          "type": "array",
          "minItems": 1,
          "maxItems": 8,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/profileRef" }
        }
      }
    },
    "promotionSequence": {
      "type": "array",
      "const": [
        "catalog-and-fabric-policy",
        "employee-hub-manifest",
        "employee-hub-host-plan",
        "sentinel-atlas-manifest",
        "sentinel-atlas-host-plan"
      ]
    },
    "workloads": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "items": { "$ref": "#/$defs/workload" }
    }
  },
  "$defs": {
    "version": { "type": "string", "pattern": "^[0-9]{4}\\.[0-9]{2}\\.[0-9]{2}\\.[0-9]+$" },
    "profileRef": { "type": "string", "pattern": "^[a-z0-9][a-z0-9.-]{1,63}$" },
    "workload": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "assetId",
        "name",
        "ownerRef",
        "purpose",
        "environment",
        "criticality",
        "dataClassification",
        "lifecycle",
        "reviewOrRetirementDate",
        "dependencies",
        "imageRef",
        "firmwareProfileRef",
        "processors",
        "memory",
        "storageProfileRef",
        "osDiskGiB",
        "networkProfileRef",
        "bootstrapProfileRef",
        "recoveryProfileRef",
        "accessProfileRef",
        "desiredPowerState",
        "destroyProtection"
      ],
      "properties": {
        "assetId": { "type": "string", "pattern": "^NG-VM-[0-9]{3,}$" },
        "name": { "type": "string", "pattern": "^[A-Z](?:[A-Z0-9-]{0,13}[A-Z0-9])?$" },
        "ownerRef": { "$ref": "#/$defs/profileRef" },
        "purpose": { "type": "string", "minLength": 1, "maxLength": 240, "pattern": "^[ -~]+$" },
        "environment": { "enum": ["lab", "tooling", "security", "infrastructure"] },
        "criticality": { "enum": ["low", "moderate", "high", "critical"] },
        "dataClassification": { "enum": ["internal", "confidential", "restricted"] },
        "lifecycle": { "const": "proposed" },
        "reviewOrRetirementDate": { "type": "string", "format": "date" },
        "dependencies": {
          "type": "array",
          "maxItems": 20,
          "uniqueItems": true,
          "items": { "type": "string", "pattern": "^NG-VM-[0-9]{3,}$" }
        },
        "imageRef": { "$ref": "#/$defs/profileRef" },
        "firmwareProfileRef": { "$ref": "#/$defs/profileRef" },
        "processors": { "type": "integer", "minimum": 1, "maximum": 8 },
        "memory": {
          "type": "object",
          "additionalProperties": false,
          "required": ["mode", "minimumMiB", "startupMiB", "maximumMiB"],
          "properties": {
            "mode": { "const": "dynamic" },
            "minimumMiB": { "type": "integer", "multipleOf": 128, "minimum": 512, "maximum": 32768 },
            "startupMiB": { "type": "integer", "multipleOf": 128, "minimum": 1024, "maximum": 32768 },
            "maximumMiB": { "type": "integer", "multipleOf": 128, "minimum": 1024, "maximum": 65536 }
          }
        },
        "storageProfileRef": { "$ref": "#/$defs/profileRef" },
        "osDiskGiB": { "type": "integer", "minimum": 20, "maximum": 256 },
        "networkProfileRef": { "$ref": "#/$defs/profileRef" },
        "bootstrapProfileRef": { "$ref": "#/$defs/profileRef" },
        "recoveryProfileRef": { "$ref": "#/$defs/profileRef" },
        "accessProfileRef": { "$ref": "#/$defs/profileRef" },
        "desiredPowerState": { "enum": ["unmanaged", "off", "running"] },
        "destroyProtection": { "const": true }
      }
    }
  }
}
