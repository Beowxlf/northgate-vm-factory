{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Beowxlf/northgate-vm-factory/schemas/resource-policy.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["$schema", "apiVersion", "kind", "policyVersion", "status", "applyEnabled", "hostReserveMemoryMiB", "minimumVolumeFreeGiB", "minimumVolumeFreePercent", "perVm", "plannerActions", "executableActions", "deniedOperations"],
  "properties": {
    "$schema": { "const": "../schemas/resource-policy.schema.json" },
    "apiVersion": { "const": "northgate/v1alpha1" },
    "kind": { "const": "ResourcePolicy" },
    "policyVersion": { "type": "string", "pattern": "^[0-9]{4}\\.[0-9]{2}\\.[0-9]{2}\\.[0-9]+$" },
    "status": { "enum": ["proposed", "approved"] },
    "applyEnabled": { "type": "boolean" },
    "hostReserveMemoryMiB": { "type": "integer", "minimum": 32768 },
    "minimumVolumeFreeGiB": { "type": "integer", "minimum": 50 },
    "minimumVolumeFreePercent": { "type": "integer", "minimum": 10, "maximum": 50 },
    "perVm": {
      "type": "object",
      "additionalProperties": false,
      "required": ["maximumProcessors", "maximumStartupMemoryMiB", "maximumDynamicMemoryMiB", "maximumOsDiskGiB"],
      "properties": {
        "maximumProcessors": { "type": "integer", "minimum": 1, "maximum": 8 },
        "maximumStartupMemoryMiB": { "type": "integer", "minimum": 1024, "maximum": 32768 },
        "maximumDynamicMemoryMiB": { "type": "integer", "minimum": 1024, "maximum": 65536 },
        "maximumOsDiskGiB": { "type": "integer", "minimum": 20, "maximum": 256 }
      }
    },
    "plannerActions": {
      "type": "array",
      "const": ["NoOp", "Create", "UpdateOnline", "UpdateOffline", "ReplaceRequired", "DecommissionRequired"]
    },
    "executableActions": {
      "type": "array",
      "maxItems": 1,
      "uniqueItems": true,
      "items": { "const": "Create" }
    },
    "deniedOperations": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{1,63}$" }
    }
  },
  "allOf": [
    {
      "if": { "properties": { "status": { "const": "proposed" } }, "required": ["status"] },
      "then": {
        "properties": {
          "applyEnabled": { "const": false },
          "executableActions": { "maxItems": 0 }
        }
      }
    },
    {
      "if": { "properties": { "status": { "const": "approved" } }, "required": ["status"] },
      "then": {
        "properties": {
          "applyEnabled": { "const": true },
          "executableActions": { "const": ["Create"] }
        }
      }
    }
  ]
}
