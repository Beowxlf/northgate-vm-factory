{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "northgate/create-only-initial-activation/v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema", "activationId", "changeId", "authorizationSha256",
    "releaseManifestSha256", "backendPolicySha256", "dataBundleSha256",
    "repository", "fromStage", "toStage", "applyEnabled", "executableActions",
    "readinessEvidenceSha256", "issuedAtUtc", "expiresAtUtc", "approverSid", "nonce"
  ],
  "properties": {
    "schema": { "const": "northgate/create-only-initial-activation/v1" },
    "activationId": { "type": "string", "pattern": "^ngactivate-[a-f0-9]{64}$" },
    "changeId": { "type": "string", "pattern": "^NG-CHG-[0-9]{8}-[A-Z0-9-]{3,32}$" },
    "authorizationSha256": { "$ref": "#/$defs/hash" },
    "releaseManifestSha256": { "$ref": "#/$defs/hash" },
    "backendPolicySha256": { "$ref": "#/$defs/hash" },
    "dataBundleSha256": { "$ref": "#/$defs/hash" },
    "repository": {
      "type": "object",
      "additionalProperties": false,
      "required": ["identity", "commit", "tree"],
      "properties": {
        "identity": { "const": "Beowxlf/northgate-vm-factory" },
        "commit": { "type": "string", "pattern": "^[a-f0-9]{40}$" },
        "tree": { "type": "string", "pattern": "^[a-f0-9]{40}$" }
      }
    },
    "fromStage": { "const": "disabled" },
    "toStage": { "const": "debian-canary" },
    "applyEnabled": { "const": true },
    "executableActions": { "type": "array", "prefixItems": [{ "const": "Create" }], "items": false },
    "readinessEvidenceSha256": { "$ref": "#/$defs/hash" },
    "issuedAtUtc": { "$ref": "#/$defs/time" },
    "expiresAtUtc": { "$ref": "#/$defs/time" },
    "approverSid": { "type": "string", "pattern": "^S-1-[0-9-]+$" },
    "nonce": { "$ref": "#/$defs/hash" }
  },
  "$defs": {
    "hash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "time": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$" }
  }
}
