{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "northgate/create-only-signed-receipt/v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "receiptId", "completedAtUtc", "executionId", "planId", "planHash", "planAuthenticationHash", "approvalId", "approvalSha256", "repository", "releaseManifestSha256", "authorizationSha256", "policySha256", "rolloutAuthorizationSha256", "rolloutSequence", "rolloutStage", "dataBundleSha256", "manifestSha256", "catalogHash", "beforeIdentityHash", "beforeCapacityHash", "afterStateHash", "afterStateVerified", "outcome", "reasonCode", "quarantineState", "rollbackState", "operation", "controls"],
  "properties": {
    "schema": { "const": "northgate/create-only-signed-receipt/v1" },
    "receiptId": { "type": "string", "pattern": "^ngr-[a-f0-9]{64}$" }, "completedAtUtc": { "type": "string" },
    "executionId": { "type": "string", "pattern": "^ngx-[a-f0-9]{64}$" }, "planId": { "type": "string", "pattern": "^ngp-[a-f0-9]{64}$" },
    "planHash": { "$ref": "#/$defs/hash" }, "planAuthenticationHash": { "$ref": "#/$defs/hash" },
    "approvalId": { "type": "string", "pattern": "^nga-[a-f0-9]{64}$" }, "approvalSha256": { "$ref": "#/$defs/hash" },
    "repository": { "type": "object" }, "releaseManifestSha256": { "$ref": "#/$defs/hash" },
    "authorizationSha256": { "$ref": "#/$defs/hash" }, "policySha256": { "$ref": "#/$defs/hash" },
    "rolloutAuthorizationSha256": { "$ref": "#/$defs/hash" },
    "rolloutSequence": { "type": "integer", "minimum": 0, "maximum": 2 },
    "rolloutStage": { "enum": ["debian-canary", "windows-canary", "persistent-fleet"] },
    "dataBundleSha256": { "$ref": "#/$defs/hash" }, "manifestSha256": { "$ref": "#/$defs/hash" }, "catalogHash": { "$ref": "#/$defs/hash" },
    "beforeIdentityHash": { "$ref": "#/$defs/hash" }, "beforeCapacityHash": { "$ref": "#/$defs/hash" }, "afterStateHash": { "$ref": "#/$defs/hash" },
    "afterStateVerified": { "type": "boolean" }, "outcome": { "enum": ["Succeeded", "Failed", "OutcomeUnknown"] },
    "reasonCode": { "type": "string", "pattern": "^NGCB-[A-Z0-9-]+$" }, "quarantineState": { "enum": ["not-required", "required", "completed"] },
    "rollbackState": { "const": "not-applicable-create-only" }, "operation": { "$ref": "#/$defs/operation" }, "controls": { "type": "object" }
  },
  "$defs": {
    "hash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "operation": {
      "type": "object", "additionalProperties": false,
      "required": ["action", "assetId", "name", "changeId", "reservationId", "vmId", "adapterPolicyId", "adapterReservationId", "adapterId", "staticMacAddress", "dynamicMacAddressEnabled", "secureBootEnabled", "secureBootTemplate", "secureBootExceptionId", "vtpmRequired", "vtpmEnabled", "bootstrapMediaId", "bootstrapMediaMode", "bootstrapMediaSha256", "bootstrapMediaSourceImageSha256", "bootstrapMediaProvenanceSha256", "bootstrapMediaBundleManifestSha256", "bootstrapMediaUnattendedPayloadSha256", "installationMediaPaths", "storageRoot", "assetRoot", "vhdPath", "switchId", "vlanId", "desiredPowerState", "destroyProtection"],
      "properties": {
        "action": { "const": "Create" }, "assetId": { "type": "string", "pattern": "^NG-VM-[0-9]{3,}$" },
        "name": { "type": "string" }, "changeId": { "type": "string", "pattern": "^NG-CHG-[0-9]{8}-[0-9]{3,}$" },
        "reservationId": { "type": "string", "pattern": "^ngrsv-[a-f0-9]{64}$" }, "vmId": { "type": "string" },
        "adapterPolicyId": { "type": "string" }, "adapterReservationId": { "type": "string" }, "adapterId": { "type": "string" },
        "staticMacAddress": { "type": "string", "pattern": "^02[0-9A-F]{10}$" }, "dynamicMacAddressEnabled": { "type": "boolean" },
        "secureBootEnabled": { "type": "boolean" }, "secureBootTemplate": { "type": "string" }, "secureBootExceptionId": { "type": "string" },
        "vtpmRequired": { "type": "boolean" }, "vtpmEnabled": { "type": "boolean" },
        "bootstrapMediaId": { "type": "string", "pattern": "^ngmedia-ng-vm-[0-9]{3,}$" },
        "bootstrapMediaMode": { "const": "asset-bound-derivative-iso" },
        "bootstrapMediaSha256": { "$ref": "#/$defs/hash" }, "bootstrapMediaSourceImageSha256": { "$ref": "#/$defs/hash" },
        "bootstrapMediaProvenanceSha256": { "$ref": "#/$defs/hash" }, "bootstrapMediaBundleManifestSha256": { "$ref": "#/$defs/hash" },
        "bootstrapMediaUnattendedPayloadSha256": { "$ref": "#/$defs/hash" },
        "installationMediaPaths": { "type": "array", "minItems": 1, "maxItems": 1, "uniqueItems": true, "items": { "type": "string", "pattern": "^[A-Za-z]:\\\\" } },
        "storageRoot": { "type": "string" }, "assetRoot": { "type": "string" }, "vhdPath": { "type": "string" },
        "switchId": { "type": "string" }, "vlanId": { "enum": [110, 120, 130, 140, 150, 160, 240, 250] },
        "desiredPowerState": { "enum": ["off", "running"] }, "destroyProtection": { "const": true }
      }
    }
  }
}
